PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/kiranalens
GROQ_API_KEY=your_groq_key_here

# For Docker: docker-compose reads GROQ_API_KEY from your shell environment.
# Set it before running docker-compose up:
#   Windows:  $env:GROQ_API_KEY="your_key"  then  docker-compose up --build
#   Mac/Linux: GROQ_API_KEY=your_key docker-compose up --build